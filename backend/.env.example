# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tianrenfan3-png.github.io

# Firebase Admin (path to service account JSON or inline JSON string)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}  # single line; use \n inside private_key
# FIREBASE_CREDENTIALS_JSON_B64=...  # base64 of the JSON file (recommended on Railway)

# Firestore
FIRESTORE_PROJECT_ID=your-project-id
USE_FIRESTORE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080

# ML
CLIP_MODEL=ViT-B/32
CLIP_TEMPERATURE=0.07
ANALYZER_TYPE=clip
# Set to mock for CI / local without GPU
# ANALYZER_TYPE=mock

# Upload limits
MAX_UPLOAD_BYTES=5242880

# Rate limiting
PREDICT_RATE_LIMIT=30/hour
